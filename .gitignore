# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual environment
.venv/
venv/
env/

# Environment files
.env
.env.local
.env.*.local
# Catch-all: any .env sidecar (.env.bak, .env.old, .env.prod, editor backups).
# .env.example is the one exception - it lists names only, never values.
.env*
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Node
node_modules/
frontend/dist/
frontend/build/

# Postgres
*.sql.bak

# Testing
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# Alembic
alembic/versions/__pycache__/

# Misc
*.log
.scratch/

# Original handoff copies (kept outside the repo)
files (2)/
files (2).zip

# Claude Code local settings
.claude/settings.local.json

# Factory builder worktrees
.claude/worktrees/
.neon

# Generated radar reports are shared privately, never committed (D66)
reports/

# Prospect lists and other private business documents never enter the public repo.
*.docx
*.xlsx
private/
checkpoints/
.refs/

# Baked demo reports are produced by the nightly workflow, never committed.
demo_reports/*
!demo_reports/.keep
site_data/
