# Northvaine settings. Copy to .env (never committed) and fill in values.
# Names only: nothing here is a real or guessed value. See northvaine/core/settings.py.

# --- Database ---------------------------------------------------------------
# Form: postgresql+asyncpg://user:pass@host:5432/db?ssl=require
DATABASE_URL=
# Only for db tests (scripts/tasks.py db-test). Never point it at the demo database.
TEST_DATABASE_URL=
# session (default) for a direct connection; transaction for a pooled endpoint
# (a PgBouncer pool_mode=transaction host, e.g. a Neon "-pooler" host).
DB_POOL_MODE=
DB_POOL_SIZE=
DB_MAX_OVERFLOW=
DB_ECHO=
# database (default): db tests create and drop nv_test_<hex>; reuse: migrate TEST_DATABASE_URL itself.
TEST_DB_ISOLATION=

# --- LLM: Nebius Token Factory ------------------------------------------------
# Values are confirmed in milestone 2 and recorded in docs/integrations/. Never guess them.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=
MODEL_FAST=
MODEL_MID=
MODEL_DEEP=
# Token Factory serves no Nemotron embedding model (DECISIONS D6): the catalog has exactly one
# embedder, Qwen/Qwen3-Embedding-8B. The hackathon's Nemotron requirement is met by the
# fast/mid/deep generation tiers above.
MODEL_EMBED=
# Must equal northvaine.core.standards.EMBED_DIM_EXPECTED (the single source of the number;
# DECISIONS D7, D14) or every LLM call refuses to run.
EMBED_DIM=

# --- Sensors ------------------------------------------------------------------
# Tavily search key (free tier). TED needs no key. Fetch/TED/Tavily tuning has defaults
# in northvaine/core/settings.py.
TAVILY_API_KEY=

# --- Budget (brain/budget.py checks all four before every call) ---------------
# Hard stop per workspace per UTC day, in USD. No default: calls refuse to run until it is set.
DAILY_BUDGET_USD=
# Lifetime hard stop, summed from llm_calls.cost_usd across every row, in USD. No default:
# calls refuse to run until it is set. Set it equal to DAILY_BUDGET_USD so the daily cap can
# never outspend the lifetime one (DECISIONS D1).
TOTAL_BUDGET_USD=
# Hard stop per RunContext, in USD. Has a conservative default (settings.py): a cap with no
# default would block every run.
RUN_BUDGET_USD=
# Hard stop per single LLM call, in USD. Has a conservative default (settings.py).
MAX_CALL_COST_USD=
# Per-call HTTP timeout, in seconds, and the number of repair retries on invalid JSON output.
# Both have conservative defaults (settings.py).
LLM_TIMEOUT_SECONDS=
LLM_MAX_RETRIES=

# --- Jobs queue (defaults in settings.py) ---------------------------------------
JOB_LEASE_SECONDS=
JOB_MAX_ATTEMPTS=
JOB_BACKOFF_BASE_SECONDS=
JOB_BACKOFF_MAX_SECONDS=
COMPANIES_HOUSE_API_KEY=      # free, Live REST key (developer.company-information.service.gov.uk)
COMPANIES_HOUSE_STREAM_KEY=   # optional: Streaming API key, for live change alerts
